#!/usr/bin/env bash
set -uo pipefail

default_models=(
  opencode/beam-free
  opencode/space-bunny-free
  opencode/deepseek-v4.1-flash-free
  opencode/mimo-v2.6-flash-free
  opencode/big-pickle
)

models=()
while getopts m: opt; do
  case "$opt" in
    m) models+=("$OPTARG") ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))

if [[ ${#models[@]} -eq 0 ]]; then
  if [[ -n "${OC_DELEGATE_MODELS:-}" ]]; then
    read -ra models <<< "$OC_DELEGATE_MODELS"
  else
    models=("${default_models[@]}")
  fi
fi

if [[ $# -eq 0 ]]; then
  echo "usage: oc-delegate [-m provider/model]... \"task\"" >&2
  exit 2
fi
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "oc-delegate: not inside a git repo; refusing so edits stay reviewable" >&2
  exit 1
fi

top="$(git rev-parse --show-toplevel)"
real_index="$(git rev-parse --path-format=absolute --git-path index)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

snapshot() {
  rm -f "$tmp/index"
  [[ -f "$real_index" ]] && cp "$real_index" "$tmp/index"
  GIT_INDEX_FILE="$tmp/index" git -C "$top" add -A >/dev/null 2>&1
  GIT_INDEX_FILE="$tmp/index" git -C "$top" write-tree
}

touched_paths() {
  jq -r 'select(.type == "tool_use") | .part.state.input | objects | (.path, .filePath) | strings' "$1" 2>/dev/null \
    | while IFS= read -r p; do
        [[ "$p" == /* ]] || p="$PWD/$p"
        realpath -m -- "$p"
      done | sort -u
}

outside_diff() {
  local p rel
  touched_paths "$1" | while IFS= read -r p; do
    [[ -f "$p" && "$p" -nt "$tmp/start" ]] || continue
    rel="${p#"$top"/}"
    if [[ "$p" != "$top"/* || "/$rel/" == */.git/* ]] || git -C "$top" check-ignore -q -- "$rel"; then
      printf '%s\n' "$rel"
    fi
  done
}

rollback() {
  local before="$1" out="$2" after status path abs
  after="$(snapshot)"
  [[ "$before" == "$after" ]] && return
  touched_paths "$out" > "$tmp/touched"
  while IFS= read -r -d '' status && IFS= read -r -d '' path; do
    abs="$top/$path"
    if ! grep -qxF -- "$abs" "$tmp/touched"; then
      echo "  left alone (not edited by worker): $path" >&2
      continue
    fi
    if [[ "$status" == A ]]; then
      rm -f -- "$abs"
    else
      git -C "$top" restore --source="$before" --worktree -- ":(literal)$path"
    fi
    echo "  reverted: $path" >&2
  done < <(git diff-tree -r -z --no-renames --name-status "$before" "$after")
}

tree_pids() {
  local p
  echo "$1"
  for p in $(pgrep -P "$1"); do
    tree_pids "$p"
  done
}

last_recv() {
  local pids
  pids="$(tree_pids "$1" | paste -sd'|' -)"
  { ss -tlnpH; echo --; ss -tinpnH; } 2>/dev/null | awk -v re="pid=($pids)," '
    $0 == "--" { est = 1; next }
    !est { if ($0 ~ re) { n = split($4, a, ":"); own[a[n]] = 1 }; next }
    /^[^ \t]/ { n = split($4, a, ":"); m = split($5, b, ":"); mine = $0 ~ re && !(a[n] in own) && !(b[m] in own); next }
    mine && match($0, /lastrcv:[0-9]+/) { v = substr($0, RSTART + 8, RLENGTH - 8) + 0; if (min == "" || v < min) min = v }
    END { if (min != "") print int(min / 1000) }'
}

stop_worker() {
  local pids
  mapfile -t pids < <(tree_pids "$worker")
  kill "${pids[@]}" 2>/dev/null
  for _ in 1 2 3 4 5; do
    kill -0 "$worker" 2>/dev/null || break
    sleep 1
  done
  kill -9 "${pids[@]}" 2>/dev/null
  wait "$worker" 2>/dev/null
  worker=""
}

run_model() {
  local model="$1" out="$2" budget="$3" start last_change size last_size=-1 recv code
  timed_out=""
  touch "$tmp/start"
  ${sandbox[@]+"${sandbox[@]}"} opencode run --standalone --agent cc-worker -m "$model" --format json \
    --title "cc: ${task:0:40}" "$task" < /dev/null > "$out" 2> "$tmp/err" &
  worker=$!
  start=$SECONDS
  last_change=$SECONDS
  while kill -0 "$worker" 2>/dev/null; do
    sleep 2
    size="$(stat -c %s "$out" 2>/dev/null || echo 0)"
    if [[ "$size" != "$last_size" ]]; then
      last_size="$size"
      last_change=$SECONDS
    fi
    recv="$(last_recv "$worker")"
    if [[ -n "$recv" ]] && (( SECONDS - recv > last_change )); then
      last_change=$((SECONDS - recv))
    fi
    if (( SECONDS - last_change >= idle )); then
      timed_out="no output or network traffic for ${idle}s"
    elif (( SECONDS - start >= budget )); then
      timed_out="timed out after ${budget}s"
    fi
    if [[ -n "$timed_out" ]]; then
      stop_worker
      return 124
    fi
  done
  wait "$worker"
  code=$?
  worker=""
  return "$code"
}

log_run() {
  local summary="${task//[$'\t\n']/ }" detail="${3//[$'\t\n']/ }"
  mkdir -p -- "$(dirname -- "$log")" 2>/dev/null
  printf '%s\t%s\t%s\t%ss\t%s\t%s\t%s\n' "$(date -Is)" "$1" "$2" "$((SECONDS - attempt_start))" \
    "$top" "${detail:0:120}" "${summary:0:100}" >> "$log" 2>/dev/null
}

interrupted() {
  trap - INT TERM HUP
  if [[ -n "$worker" ]]; then
    stop_worker
    log_run fail "$model" interrupted
  fi
  echo "oc-delegate: interrupted; reverting the worker's edits" >&2
  rollback "$before" "$out"
  exit 130
}

task="$*"
limit="${OC_DELEGATE_TIMEOUT:-300}"
idle="${OC_DELEGATE_IDLE:-180}"
total="${OC_DELEGATE_TOTAL:-540}"
log="${OC_DELEGATE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/oc-delegate.log}"
out="$tmp/out.jsonl"
worker=""

sandbox=()
if [[ "${OC_DELEGATE_SANDBOX:-1}" == 0 ]]; then
  :
elif command -v bwrap >/dev/null && bwrap --ro-bind / / true 2>/dev/null; then
  sandbox=(bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --bind "$top" "$top")
  [[ -e "$top/.git" ]] && sandbox+=(--ro-bind "$top/.git" "$top/.git")
  for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" "${XDG_CACHE_HOME:-$HOME/.cache}" "${XDG_STATE_HOME:-$HOME/.local/state}"; do
    mkdir -p -- "$dir/opencode"
    sandbox+=(--bind "$dir/opencode" "$dir/opencode")
  done
  sandbox+=(--chdir "$PWD" --unshare-pid --die-with-parent --new-session --)
else
  echo "oc-delegate: bwrap unavailable; running the worker without the filesystem sandbox" >&2
fi

before="$(snapshot)"
trap interrupted INT TERM HUP
deadline=$((SECONDS + total))

for model in "${models[@]}"; do
  budget=$((deadline - SECONDS))
  (( budget > limit )) && budget=$limit
  if (( budget < 30 )); then
    echo "oc-delegate: ${total}s overall limit reached before trying $model" >&2
    break
  fi
  attempt_start=$SECONDS
  run_model "$model" "$out" "$budget"
  code=$?

  err="$(jq -r 'select(.type == "error") | "\(.error.type // "error"): \(.error.message // (.error | tostring))"' "$out" 2>/dev/null | tail -n 1)"
  text="$(jq -r 'select(.type == "text") | .part.text' "$out" 2>/dev/null)"
  if [[ -n "$timed_out" ]]; then
    err="$timed_out"
  elif [[ $code -ne 0 && -z "$err" ]]; then
    err="exit $code: $(tail -n 3 "$tmp/err" | tr '\n' ' ')"
  elif [[ -z "$err" && -z "$text" ]]; then
    err="no response text"
  fi

  if [[ -z "$err" ]]; then
    trap - INT TERM HUP
    after="$(snapshot)"
    echo "model: $model"
    echo "changed:"
    changes="$(git diff-tree -r --no-renames --name-status "$before" "$after")"
    if [[ -n "$changes" ]]; then
      sed 's/^/  /' <<< "$changes"
    else
      echo "  (none)"
    fi
    hidden="$(outside_diff "$out")"
    if [[ -n "$hidden" ]]; then
      echo "not in git diff (gitignored or .git):"
      sed 's/^/  /' <<< "$hidden"
    fi
    log_run ok "$model" "$(grep -c . <<< "$changes") files changed"
    tool_errors="$(jq -r 'select(.type == "tool_use" and .part.state.status == "error") | "  \(.part.tool): \(.part.state.error // .part.state.output // "" | tostring | .[0:120])"' "$out" 2>/dev/null | head -n 5)"
    [[ -n "$tool_errors" ]] && printf 'tool errors:\n%s\n' "$tool_errors"
    echo "---"
    printf '%s\n' "$text" | tail -n "${OC_DELEGATE_TAIL:-40}"
    exit 0
  fi

  echo "oc-delegate: $model failed ($err)" >&2
  log_run fail "$model" "$err"
  outside_diff "$out" | sed 's/^/  not reverted (gitignored or .git): /' >&2
  rollback "$before" "$out"
done

echo "oc-delegate: all models failed (${models[*]})" >&2
exit 1
